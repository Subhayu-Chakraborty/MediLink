# ─────────────────────────────────────────────────────────────
# AI-Based Medical Report Analyzer — Backend Environment File
# Copy this file to .env and fill in your real values.
# DO NOT commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── MongoDB Atlas ─────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Python/Motor
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=medical_report_analyzer

# ── JWT Authentication ────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AI / Ollama ───────────────────────────────────────────────────────────
# Ensure Ollama is running locally (e.g. `ollama run llama3`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# ── File Uploads ──────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── Application ───────────────────────────────────────────────
ENVIRONMENT=development
